local CLASS_COLORS = {
	ScreenGui = Color3.fromRGB(80, 160, 255),
	Frame = Color3.fromRGB(160, 200, 80),
	TextLabel = Color3.fromRGB(255, 200, 80),
	TextButton = Color3.fromRGB(255, 140, 80),
	ImageLabel = Color3.fromRGB(200, 120, 255),
	ImageButton = Color3.fromRGB(200, 100, 255),
	TextBox = Color3.fromRGB(80, 255, 200),
	ScrollingFrame = Color3.fromRGB(100, 255, 150),
	Folder = Color3.fromRGB(170, 170, 190),
}

local function getClassColor(className)
	return CLASS_COLORS[className] or Color3.fromRGB(180, 180, 190)
end

-- ====== Helpers ======
local function getRelativePath(instance)
	local path = {}
	local current = instance
	while current and current ~= playerGui do
		table.insert(path, 1, current.Name)
		current = current.Parent
	end
	if current == playerGui then
		table.insert(path, 1, "PlayerGui")
	end
	return table.concat(path, ".")
end

local function getGuiChildren(instance)
	local result = {}
	for _, child in ipairs(instance:GetChildren()) do
		if child ~= screenGui then
			if child:IsA("GuiObject") or child:IsA("ScreenGui") or child:IsA("Folder") then
				table.insert(result, child)
			end
		end
	end
	return result
end

local function updateCanvasSize(scroll)
	task.defer(function()
		local h = 0
		for _, v in ipairs(scroll:GetChildren()) do
			if v:IsA("Frame") or v:IsA("TextLabel") then
				h += v.AbsoluteSize.Y + 2
			end
		end
		scroll.CanvasSize = UDim2.new(0, 0, 0, h)
	end)
end

-- ====== Safe property reader ======
local function safeProp(obj, propName)
	local ok, val = pcall(function()
		return obj[propName]
	end)
	if ok then return val end
	return nil
end

local function formatValue(val)
	if typeof(val) == "boolean" then
		return val and "true" or "false"
	elseif typeof(val) == "number" then
		return tostring(val)
	elseif typeof(val) == "string" then
		return val
	elseif typeof(val) == "Color3" then
		return string.format("RGB(%d,%d,%d)",
			math.floor(val.R * 255), math.floor(val.G * 255), math.floor(val.B * 255))
	elseif typeof(val) == "UDim2" then
		return string.format("{%.2f,%d},{%.2f,%d}",
			val.X.Scale, val.X.Offset, val.Y.Scale, val.Y.Offset)
	elseif typeof(val) == "UDim" then
		return string.format("{%.2f,%d}", val.Scale, val.Offset)
	elseif typeof(val) == "EnumItem" then
		return tostring(val.Name)
	elseif typeof(val) == "Vector2" then
		return string.format("(%d,%d)", val.X, val.Y)
	elseif typeof(val) == "Instance" then
		return val.Name .. " [" .. val.ClassName .. "]"
	else
		return tostring(val)
	end
end

-- Property sets per class
local function getPropertiesForInstance(obj)
	local props = {"Name"}

	if obj:IsA("ScreenGui") then
		table.insert(props, "Enabled")
		table.insert(props, "DisplayOrder")
		table.insert(props, "ResetOnSpawn")
		table.insert(props, "ZIndexBehavior")
		table.insert(props, "IgnoreGuiInset")
		table.insert(props, "AlwaysOnTop")
	end

	if obj:IsA("GuiObject") then
		table.insert(props, "Visible")
		table.insert(props, "Position")
		table.insert(props, "Size")
		table.insert(props, "AnchorPoint")
		table.insert(props, "BackgroundColor3")
		table.insert(props, "BackgroundTransparency")
		table.insert(props, "BorderSizePixel")
		table.insert(props, "ZIndex")
		table.insert(props, "LayoutOrder")
		table.insert(props, "AutomaticSize")
	end

	if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
		table.insert(props, "Text")
		table.insert(props, "TextColor3")
		table.insert(props, "TextScaled")
		table.insert(props, "TextSize")
		table.insert(props, "Font")
		table.insert(props, "TextXAlignment")
		table.insert(props, "TextYAlignment")
		table.insert(props, "TextTransparency")
	end

	if obj:IsA("TextButton") or obj:IsA("ImageButton") then
		table.insert(props, "AutoButtonColor")
		table.insert(props, "Modal")
	end

	if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
		table.insert(props, "Image")
		table.insert(props, "ImageColor3")
		table.insert(props, "ImageTransparency")
		table.insert(props, "ScaleType")
	end

	if obj:IsA("ScrollingFrame") then
		table.insert(props, "ScrollBarThickness")
		table.insert(props, "CanvasSize")
		table.insert(props, "AutomaticCanvasSize")
		table.insert(props, "ScrollingDirection")
		table.insert(props, "ScrollBarImageColor3")
	end

	return props
end

