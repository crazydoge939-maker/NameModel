-- ====== Populate info panel ======
populateInfo = function(instance)
	for _, child in ipairs(infoScroll:GetChildren()) do
		if child ~= infoHeader and not child:IsA("UIListLayout") then
			child:Destroy()
		end
	end

	infoHeader.Text = " " .. instance.Name .. " [" .. instance.ClassName .. "]"

	local props = getPropertiesForInstance(instance)

	for i, propName in ipairs(props) do
		local val = safeProp(instance, propName)
		local valStr = "<unreadable>"
		if val ~= nil then
			valStr = formatValue(val)
		end

		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, 0, 0.055, 0)
		row.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
		row.BorderSizePixel = 0
		row.LayoutOrder = i

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.1, 0)
		corner.Parent = row

		local pad = Instance.new("UIPadding")
		pad.PaddingLeft = UDim.new(0.03, 0)
		pad.PaddingRight = UDim.new(0.03, 0)
		pad.Parent = row

		local nameLbl = Instance.new("TextLabel")
		nameLbl.Size = UDim2.new(0.4, 0, 1, 0)
		nameLbl.BackgroundTransparency = 1
		nameLbl.Text = propName
		nameLbl.TextColor3 = Color3.fromRGB(130, 180, 255)
		nameLbl.Font = Enum.Font.GothamBold
		nameLbl.TextScaled = true
		nameLbl.TextXAlignment = Enum.TextXAlignment.Left
		nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
		nameLbl.Parent = row

		local valLbl = Instance.new("TextLabel")
		valLbl.Size = UDim2.new(0.58, 0, 1, 0)
		valLbl.Position = UDim2.new(0.42, 0, 0, 0)
		valLbl.BackgroundTransparency = 1
		valLbl.Text = valStr
		valLbl.Font = Enum.Font.Code
		valLbl.TextScaled = true
		valLbl.TextXAlignment = Enum.TextXAlignment.Left
		valLbl.TextTruncate = Enum.TextTruncate.AtEnd
		valLbl.Parent = row

		if typeof(val) == "boolean" then
			valLbl.TextColor3 = val and Color3.fromRGB(100, 220, 100) or Color3.fromRGB(220, 100, 100)
		else
			valLbl.TextColor3 = Color3.fromRGB(200, 220, 180)
		end

		row.Parent = infoScroll
	end

	updateCanvasSize(infoScroll)
end

-- ====== Create a clickable row ======
local function createRow(instance, isLeft)
	local row = Instance.new("TextButton")
	row.Size = UDim2.new(1, -0.01, 0.07, 0)
	row.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
	row.BorderSizePixel = 0
	row.Text = ""
	row.TextScaled = true
	row.Font = Enum.Font.SourceSans
	row.LayoutOrder = layoutOrder
	layoutOrder += 1
	row.AutoButtonColor = true

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.1, 0)
	corner.Parent = row

	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.02, 0)
	pad.PaddingRight = UDim.new(0.02, 0)
	pad.PaddingTop = UDim.new(0.01, 0)
	pad.PaddingBottom = UDim.new(0.01, 0)
	pad.Parent = row

	local children = getGuiChildren(instance)
	local hasChildren = #children > 0

	local nameLbl = Instance.new("TextLabel")
	nameLbl.Size = UDim2.new(0.5, 0, 1, 0)
	nameLbl.BackgroundTransparency = 1
	nameLbl.Text = instance.Name
	nameLbl.TextColor3 = getClassColor(instance.ClassName)
	nameLbl.Font = Enum.Font.GothamBold
	nameLbl.TextScaled = true
	nameLbl.TextXAlignment = Enum.TextXAlignment.Left
	nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
	nameLbl.Parent = row

	local classLbl = Instance.new("TextLabel")
	classLbl.Size = UDim2.new(0.3, 0, 1, 0)
	classLbl.Position = UDim2.new(0.5, 0, 0, 0)
	classLbl.BackgroundTransparency = 1
	classLbl.Text = "[" .. instance.ClassName .. "]"
	classLbl.TextColor3 = Color3.fromRGB(140, 140, 150)
	classLbl.Font = Enum.Font.Gotham
	classLbl.TextScaled = true
	classLbl.TextXAlignment = Enum.TextXAlignment.Left
	classLbl.Parent = row

	local arrowLbl = Instance.new("TextLabel")
	arrowLbl.Size = UDim2.new(0.08, 0, 1, 0)
	arrowLbl.Position = UDim2.new(0.82, 0, 0, 0)
	arrowLbl.BackgroundTransparency = 1
	arrowLbl.Text = hasChildren and "\xE2\x96\xB8" or "\xE2\x97\x8B"
	arrowLbl.TextColor3 = hasChildren and Color3.fromRGB(100, 200, 120) or Color3.fromRGB(100, 100, 110)
	arrowLbl.Font = Enum.Font.GothamBold
	arrowLbl.TextScaled = true
	arrowLbl.Parent = row

	local countLbl = Instance.new("TextLabel")
	countLbl.Size = UDim2.new(0.1, 0, 1, 0)
	countLbl.Position = UDim2.new(0.9, 0, 0, 0)
	countLbl.BackgroundTransparency = 1
	countLbl.Text = hasChildren and tostring(#children) or "-"
	countLbl.TextColor3 = hasChildren and Color3.fromRGB(120, 120, 140) or Color3.fromRGB(80, 80, 90)
	countLbl.Font = Enum.Font.Gotham
	countLbl.TextScaled = true
	countLbl.TextXAlignment = Enum.TextXAlignment.Right
	countLbl.Parent = row

	row:SetAttribute("InstanceRef", tostring(instance))

	row.MouseButton1Click:Connect(function()
		populateInfo(instance)
		if hasChildren then
			if selectedInstance then
				table.insert(navStack, selectedInstance)
			end
			selectedInstance = instance
			populateDetail(instance)
		else
			row.BackgroundColor3 = Color3.fromRGB(60, 60, 50)
			task.delay(0.2, function()
				row.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
			end)
		end
	end)

	return row
end

-- ====== Populate left panel ======
local function populateLeft()
	layoutOrder = 0
	for _, child in ipairs(leftScroll:GetChildren()) do
		if child ~= leftHeader and not child:IsA("UIListLayout") then
			child:Destroy()
		end
	end
	for _, child in ipairs(playerGui:GetChildren()) do
		if child ~= screenGui then
			local row = createRow(child, true)
			row.Parent = leftScroll
		end
	end
	updateCanvasSize(leftScroll)
end

-- ====== Populate middle panel ======
populateDetail = function(instance)
	layoutOrder = 0
	for _, child in ipairs(midScroll:GetChildren()) do
		if child ~= midHeader and not child:IsA("UIListLayout") then
			child:Destroy()
		end
	end
	breadcrumbLabel.Text = getRelativePath(instance)
	local children = getGuiChildren(instance)
	if #children == 0 then
		local empty = Instance.new("TextLabel")
		empty.Size = UDim2.new(1, 0, 0.08, 0)
		empty.BackgroundTransparency = 1
		empty.Text = "No children inside"
		empty.TextColor3 = Color3.fromRGB(120, 120, 130)
		empty.Font = Enum.Font.Gotham
		empty.TextScaled = true
		empty.LayoutOrder = 0
		empty.Parent = midScroll
	else
		midHeader.Text = " " .. #children .. " children in " .. instance.Name
		for _, child in ipairs(children) do
			local row = createRow(child, false)
			row.Parent = midScroll
		end
	end
	updateCanvasSize(midScroll)
end

-- ====== Back button ======
backButton.MouseButton1Click:Connect(function()
	if #navStack > 0 then
		selectedInstance = table.remove(navStack)
		populateDetail(selectedInstance)
	elseif selectedInstance then
		selectedInstance = nil
		for _, child in ipairs(midScroll:GetChildren()) do
			if child ~= midHeader and not child:IsA("UIListLayout") then
				child:Destroy()
			end
		end
		midHeader.Text = " Select a ScreenGui"
		breadcrumbLabel.Text = "PlayerGui"
		updateCanvasSize(midScroll)
	end
end)

-- ====== Refresh button ======
refreshButton.MouseButton1Click:Connect(function()
	populateLeft()
	if selectedInstance and selectedInstance.Parent then
		populateDetail(selectedInstance)
	else
		selectedInstance = nil
		navStack = {}
		for _, child in ipairs(midScroll:GetChildren()) do
			if child ~= midHeader and not child:IsA("UIListLayout") then
				child:Destroy()
			end
		end
		midHeader.Text = " Select a ScreenGui"
		breadcrumbLabel.Text = "PlayerGui"
		updateCanvasSize(midScroll)
	end
end)

-- ====== Init ======
populateLeft()

playerGui.ChildAdded:Connect(function(child)
	if child ~= screenGui then
		populateLeft()
	end
end)
playerGui.ChildRemoved:Connect(function(child)
	if child ~= screenGui then
		populateLeft()
	end
end)
